{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jingjing.local/plugin.schema.json",
  "title": "静静插件清单（任务来源 / Worker）",
  "description": "plugins/<id>/plugin.json 与 workers/<id>/plugin.json 的规范。运行时由 src/plugin-spec.js 做同样的校验。",
  "type": "object",
  "required": [
    "id",
    "name",
    "entry"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,31}$",
      "description": "必须与所在目录名一致"
    },
    "apiVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1,
      "default": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "version": {
      "type": "string",
      "maxLength": 24,
      "default": "0.0.0"
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "icon": {
      "type": "string",
      "maxLength": 8,
      "default": "插"
    },
    "entry": {
      "type": "string",
      "minLength": 1,
      "description": "插件目录内的相对路径"
    },
    "kind": {
      "enum": [
        "source",
        "worker"
      ],
      "default": "source",
      "description": "source = 任务来源；worker = 执行器 Worker"
    },
    "type": {
      "enum": [
        "poll",
        "webhook",
        "stream",
        "manual",
        "watch"
      ],
      "default": "poll",
      "description": "来源类型；决定核心如何调度它"
    },
    "intervalMinutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1440,
      "default": 30
    },
    "webhook": {
      "type": "boolean",
      "default": false,
      "description": "为 true 时，核心会生成 POST /api/hooks/<token> 并调用插件的 webhook()"
    },
    "lifecycle": {
      "type": "boolean",
      "default": false,
      "description": "为 true 时，启用插件会调用 start(config, ctx)，停用会调用 stop()"
    },
    "multiInstance": {
      "type": "boolean",
      "default": false,
      "description": "为 true 时，同一个插件可以创建多份独立配置实例"
    },
    "classification": {
      "type": "object",
      "description": "声明这个来源能交外部对象树（节点 + 唯一父指针），静静据此自动归类。声明不等于启用：每个实例默认关。见 docs/architecture/external.md「插件怎么接」",
      "additionalProperties": false,
      "required": ["tree", "nodeTypes"],
      "properties": {
        "tree": { "const": true },
        "nodeTypes": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,23}$" }, "minItems": 1, "maxItems": 12 },
        "nodeLabels": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 12 } },
        "defaultGroupAt": {
          "oneOf": [
            { "type": "object", "required": ["type"], "properties": { "type": { "type": "string" } }, "additionalProperties": false },
            { "type": "object", "required": ["levels"], "properties": { "levels": { "type": "integer", "minimum": 1, "maximum": 8 }, "anchor": { "type": "string" } }, "additionalProperties": false }
          ]
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "network": {
          "type": "boolean"
        },
        "read": {
          "type": "boolean"
        },
        "write": {
          "type": "boolean"
        }
      }
    },
    "config": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "$ref": "#/$defs/field"
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "description": "仅 kind 为 worker 时使用：Router 按 abilities 和 cost 派活，调度器按运行限制执行",
      "properties": {
        "abilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "text",
              "write-file",
              "manage-files",
              "code",
              "memory"
            ]
          },
          "default": [
            "text"
          ],
          "description": "text 文本问答；write-file 在工作区生成文件；manage-files 整理/移动文件；code 读写代码仓库、执行命令；memory 整理记忆"
        },
        "cost": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "default": 3,
          "description": "相对开销。能力都满足时，Router 选开销最低的 Worker"
        },
        "keywords": {
          "type": "string",
          "maxLength": 300,
          "default": "",
          "description": "正则（忽略大小写）。任务文本命中时优先派给这个 Worker，比如 \"飞书|lark\""
        },
        "timeoutMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1440,
          "default": 30
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4,
          "default": 2
        },
        "retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "default": 0,
          "description": "失败后自动重试次数；超时和 retryable: false 的失败不重试"
        },
        "aliases": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30
          },
          "default": [],
          "description": "用户可能用来称呼它的名字（Claude Code / claude-cli…）。命中视为明确点名"
        },
        "capabilities": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,31}$"
          },
          "default": [],
          "description": "能力 id，参考能力目录（git、npm、tapd-cli…）。分配器按它匹配具体工具/领域"
        }
      }
    }
  },
  "if": {
    "not": {
      "properties": {
        "kind": {
          "const": "worker"
        }
      },
      "required": [
        "kind"
      ]
    }
  },
  "then": {
    "not": {
      "required": [
        "worker"
      ]
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "required": [
        "key",
        "label",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,39}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "type": {
          "enum": [
            "text",
            "url",
            "password",
            "number",
            "checkbox",
            "textarea",
            "select",
            "folder",
            "filters",
            "group"
          ]
        },
        "default": {},
        "placeholder": {
          "type": "string",
          "maxLength": 200
        },
        "help": {
          "type": "string",
          "maxLength": 300
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "wide": {
          "type": "boolean"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "value",
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "value": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            }
          }
        },
        "fields": {
          "description": "type 为 group 时：每一项的子字段（不能再放 group 和 password）",
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "itemLabel": {
          "description": "type 为 group 时：一项叫什么，比如「项目」（按钮是「加一个项目」）",
          "type": "string",
          "maxLength": 12
        },
        "maxItems": {
          "description": "type 为 group 时：最多几项（1–50，默认 20）",
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "select"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "options"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "number"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "default": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "checkbox"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "default": {
                "type": "boolean"
              }
            }
          }
        }
      ]
    }
  }
}
