<Project Sdk="Microsoft.NET.Sdk">
  <!--
    静静 Windows 桌面外壳：托盘常驻 + WebView2 原生窗口 + 系统通知，和 macOS App 对应。
    目标 .NET Framework 4.7.2：Windows 10（1803 起）和 Windows 11 都自带，用户不用另装运行时。
    构建见 build.ps1（会把服务代码和 node.exe 一起放进 build\Jingjing\）。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Jingjing</AssemblyName>
    <RootNamespace>Jingjing</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>build\app.ico</ApplicationIcon>
    <Version>0.0.0</Version>
    <Product>静静</Product>
    <AssemblyTitle>静静</AssemblyTitle>
    <Description>静静 · 本地个人 AI 工作站</Description>
    <Company>静静</Company>
    <Copyright>静静</Copyright>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- 托盘图标从这张图画出来（变灰、加数字角标都在运行时画）。 -->
    <EmbeddedResource Include="..\..\public\icon-192.png" LogicalName="Jingjing.icon.png" />
  </ItemGroup>
</Project>
